{
  "name": "nutripal-mcp",
  "version": "0.3.1",
  "description": "MCP server for MyFitnessPal account settings, food and exercise diaries, goals, measurements, and nutrition tools.",
  "module": "dist/server.js",
  "type": "module",
  "license": "MIT",
  "author": "Naoufal Elbani",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "myfitnesspal",
    "nutrition",
    "food-diary",
    "calorie-tracker",
    "bun",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/naoufalelbani/nutripal-mcp.git"
  },
  "homepage": "https://github.com/naoufalelbani/nutripal-mcp#readme",
  "bugs": {
    "url": "https://github.com/naoufalelbani/nutripal-mcp/issues"
  },
  "bin": {
    "nutripal-mcp": "bin/nutripal-mcp.js"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "assets",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "bun run src/server.ts",
    "build": "bun build src/*.ts --target=node --outdir=dist",
    "auth": "bun run src/auth.ts",
    "live-check": "bun run src/live-check.ts",
    "log-by-weight": "bun run src/log-by-weight.ts",
    "diagnose": "bun run src/diagnose.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun test && bun run typecheck && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.6"
  }
}
